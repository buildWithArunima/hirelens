# Model provider. Set ONE key; the app picks the provider from it.
# Google Gemini (free key at https://aistudio.google.com/apikey):
GEMINI_API_KEY= 

# Or NVIDIA:
# NVIDIA_API_KEY=
# Or any other OpenAI-compatible provider:
# LLM_API_KEY=
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Optional: force a model (otherwise the provider's default, e.g. gemini-flash-latest)
# LLM_MODEL=

# Optional, avoids GitHub's 60 requests/hour limit for public repos
GITHUB_TOKEN=

# PORT=3001
